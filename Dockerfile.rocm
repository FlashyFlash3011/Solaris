# Solaris — AMD GPU image (native Linux with ROCm drivers)
#
# Base: AMD's ROCm 7.2 + PyTorch 2.9.1 image (the same ROCm / PyTorch versions
# Solaris is developed and tested with). Override with --build-arg BASE_IMAGE=...
#
# Build:
#   docker build -f Dockerfile.rocm -t solaris:latest .
#
# Run (needs the ROCm kernel driver: /dev/kfd and /dev/dri on the host):
#   docker run --rm -it \
#       --device=/dev/kfd --device=/dev/dri \
#       --group-add video --group-add render \
#       -v "$(pwd)":/workspace/solaris \
#       solaris:latest bash
#
# Not for WSL2: WSL exposes the GPU as /dev/dxg (no /dev/kfd), so ROCm
# containers cannot see it there. On WSL use AMD's WSL PyTorch wheel instead
# (see README).

ARG BASE_IMAGE=rocm/pytorch:rocm7.2_ubuntu22.04_py3.10_pytorch_release_2.9.1
FROM ${BASE_IMAGE}

# GPU targets compiled by any extension builds — edit to match your hardware:
#   gfx90a = MI200 (CDNA2)   gfx942 = MI300 (CDNA3)
#   gfx1030 = RX 6800/6900 (RDNA2)   gfx1100 = RX 7900 (RDNA3)
#   gfx1200/gfx1201 = RX 9060/9070 (RDNA4)
ENV PYTORCH_ROCM_ARCH="gfx90a;gfx942;gfx1030;gfx1100;gfx1200;gfx1201"

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/solaris
COPY . .

# Install Solaris *without* resolving torch: the base image's ROCm build of
# PyTorch must not be replaced by a generic wheel from PyPI.
RUN pip install --no-cache-dir --no-deps -e . \
    && pip install --no-cache-dir \
        "numpy>=1.24.0" "loguru>=0.7.0" "h5py>=3.8.0" "scipy>=1.10.0" "matplotlib>=3.7.0" \
        "pytest>=7.4.0" "pytest-cov>=4.1.0" "ruff>=0.1.0" \
    && python -c "import torch; assert torch.version.hip, 'ROCm PyTorch was replaced'"

CMD ["python", "-c", "import solaris, torch; print('Solaris', solaris.__version__, '| torch', torch.__version__, '| backend', solaris.get_gpu_backend())"]
